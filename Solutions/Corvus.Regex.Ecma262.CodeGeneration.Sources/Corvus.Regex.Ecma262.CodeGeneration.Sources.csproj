<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Corvus.Regex.Ecma262.SourceGenerator\EmitterSources.props" />
  <Import Project="$(EndjinProjectPropsPath)" Condition="$(EndjinProjectPropsPath) != ''" />

  <!--
    The emitter as a source package: the files the source generator compiles, carried as C# that is compiled into the
    project that takes the package, so that a code generator of its own (a source generator among them) writes the
    library's generated code with no assembly beside it. Each file is written for the package with its types internal
    and in a namespace of their own (Corvus.Ecma262.RegularExpressions.CodeGeneration), so the package never clashes
    with the library in a project that references both, and marked as generated, so the analysers of that project
    pass over it. This project compiles the files as the package carries them, against System.Memory alone, which
    shows they stand alone.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>Corvus.Regex.Ecma262.CodeGeneration.Sources</PackageId>
    <Description>The Corvus.Regex.Ecma262 emitter as source: a code generator takes it to write the library's generated code for a pattern (RegexEmitter.TryEmit) into the code it generates.</Description>
    <PackageTags>regex;regular-expressions;ecmascript;ecma-262;source-generator;code-generation</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://corvus-oss.org/Corvus.Regex.Ecma262/</PackageProjectUrl>
    <!-- A package with no assembly. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EmitterSourcesDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)EmitterSources\</EmitterSourcesDir>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackEmitterSources</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Endjin.RecommendedPractices.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <UsingTask TaskName="WriteEmitterSources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <Written ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var written = new List<ITaskItem>();
        foreach (ITaskItem source in Sources)
        {
            string link = source.GetMetadata("Link");
            string relative = string.IsNullOrEmpty(link) ? source.GetMetadata("Filename") + source.GetMetadata("Extension") : link;
            if (relative.StartsWith("Shared" + Path.DirectorySeparatorChar) || relative.StartsWith("Shared/") || relative.StartsWith("Shared\\"))
            {
                relative = relative.Substring("Shared".Length + 1);
            }

            relative = relative.Replace('\\', '/');
            string text = File.ReadAllText(source.ItemSpec);
            string before = text;
            text = Regex.Replace(text, @"^namespace Corvus\.Ecma262\.RegularExpressions(\.SourceGenerator)?;", "namespace Corvus.Ecma262.RegularExpressions.CodeGeneration;", RegexOptions.Multiline);
            if (text == before)
            {
                Log.LogError(source.ItemSpec + " has no file-scoped namespace Corvus.Ecma262.RegularExpressions to move.");
                continue;
            }

            text = Regex.Replace(text, @"^public ", "internal ", RegexOptions.Multiline);
            string header =
                "// <auto-generated>\n" +
                "// The Corvus.Regex.Ecma262 emitter " + Version + ", from the Corvus.Regex.Ecma262.CodeGeneration.Sources package:\n" +
                "// compiled into the project that takes the package, with its types internal.\n" +
                "// </auto-generated>\n" +
                "#nullable enable\n" +
                "#pragma warning disable\n";
            string path = Path.Combine(OutputDirectory, relative);
            Directory.CreateDirectory(Path.GetDirectoryName(path));
            string content = header + text;
            if (!File.Exists(path) || File.ReadAllText(path) != content)
            {
                File.WriteAllText(path, content);
            }

            var item = new Microsoft.Build.Utilities.TaskItem(path);
            item.SetMetadata("PackageRelativePath", relative);
            written.Add(item);
        }

        Written = written.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The files as the package carries them, written before the build and compiled here. -->
  <Target Name="WriteEmitterSources" BeforeTargets="BeforeBuild;CoreCompile" Inputs="@(EmitterSource)" Outputs="$(EmitterSourcesDir).stamp">
    <WriteEmitterSources Sources="@(EmitterSource)" OutputDirectory="$(EmitterSourcesDir)" Version="$(Version)">
      <Output TaskParameter="Written" ItemName="_WrittenEmitterSource" />
    </WriteEmitterSources>
    <Touch Files="$(EmitterSourcesDir).stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="CompileEmitterSources" AfterTargets="WriteEmitterSources" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_EmitterSourceFile Include="$(EmitterSourcesDir)**\*.cs" />
      <Compile Include="@(_EmitterSourceFile)" />
    </ItemGroup>
  </Target>

  <!-- Into the package as content compiled by its taker (contentFiles default to Compile, not copied to output). -->
  <Target Name="PackEmitterSources" DependsOnTargets="WriteEmitterSources">
    <ItemGroup>
      <_EmitterSourcePackFile Include="$(EmitterSourcesDir)**\*.cs" />
      <TfmSpecificPackageFile Include="@(_EmitterSourcePackFile)" PackagePath="contentFiles/cs/any/CorvusRegexEcma262/%(RecursiveDir)%(Filename)%(Extension)" BuildAction="Compile" />
    </ItemGroup>
  </Target>
</Project>
