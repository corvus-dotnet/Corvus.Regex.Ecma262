    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Syntax\EcmaRegexParser.cs" Link="Shared\Syntax\EcmaRegexParser.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Unicode\EcmaRegexUnicode.cs" Link="Shared\Unicode\EcmaRegexUnicode.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Unicode\EcmaRegexUnicodeData13.cs" Link="Shared\Unicode\EcmaRegexUnicodeData13.cs" />
