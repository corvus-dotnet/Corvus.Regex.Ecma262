<Project>
  <!--
    The emitter's sources: the parser, the compiler and the emitters, which the source generator compiles and the
    Corvus.Regex.Ecma262.CodeGeneration.Sources package carries as source. One list for both.
  -->
  <ItemGroup>
    <EmitterSource Include="$(MSBuildThisFileDirectory)RegexEmitter.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)RunEmitter.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)TreeEmitter.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\GeneratedRunner.cs" Link="Shared\GeneratedRunner.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\Adfa.cs" Link="Shared\Engine\Adfa.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\CaseFolding.cs" Link="Shared\Engine\CaseFolding.cs" />
