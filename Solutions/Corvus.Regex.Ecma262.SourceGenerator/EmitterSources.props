    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\Matcher.cs" Link="Shared\Engine\Matcher.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\Needle.cs" Link="Shared\Engine\Needle.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\AlternationSearch.cs" Link="Shared\Engine\AlternationSearch.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\Teddy.cs" Link="Shared\Engine\Teddy.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\Program.cs" Link="Shared\Engine\Program.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\Engine\TextEncoding.cs" Link="Shared\Engine\TextEncoding.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\RegexFlags.cs" Link="Shared\RegexFlags.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\RegexEdition.cs" Link="Shared\RegexEdition.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\RegexUnicodeVersion.cs" Link="Shared\RegexUnicodeVersion.cs" />
    <EmitterSource Include="$(MSBuildThisFileDirectory)..\Corvus.Regex.Ecma262\RegexParseException.cs" Link="Shared\RegexParseException.cs" />
