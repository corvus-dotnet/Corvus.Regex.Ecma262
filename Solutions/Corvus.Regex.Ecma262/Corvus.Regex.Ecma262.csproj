<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(EndjinProjectPropsPath)" Condition="$(EndjinProjectPropsPath) != ''" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Corvus.Ecma262.RegularExpressions</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <!-- The netstandard2.0 build is for the source generator host and for consumers that target it; the analyzers
         that ask for the net APIs (CA1510 and the like) do not apply there. -->
    <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.0'">$(NoWarn);CA1510;CA1511;CA1512;CA1513;CA1845;CA1846;CA1847</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Corvus.Regex.Ecma262</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageDescription>An ECMA-262 regular expression engine for .NET: the grammar and answers of ECMAScript, native UTF-8 and UTF-16 matching, zero allocation per match, and a build-time source generator.</PackageDescription>
    <PackageTags>regex;regular-expressions;ecmascript;ecma-262;utf8;source-generator</PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="$(ContinuousIntegrationBuild) == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Engine\CaseFolding.cs" />
    <Compile Include="Engine\CharSet.cs" />
    <Compile Include="Engine\Dfa.cs" />
    <Compile Include="Engine\Matcher.cs" />
    <Compile Include="Engine\Program.cs" />
    <Compile Include="Engine\TextEncoding.cs" />
    <Compile Include="Engine\Needle.cs" />
    <Compile Include="Capture.cs" />
    <Compile Include="CaptureCollection.cs" />
    <Compile Include="Group.cs" />
    <Compile Include="GroupCollection.cs" />
    <Compile Include="Match.cs" />
    <Compile Include="MatchCollection.cs" />
    <Compile Include="MatchEvaluator.cs" />
    <Compile Include="Regex.cs" />
    <Compile Include="Regex.Matching.cs" />
    <Compile Include="Regex.Spans.cs" />
    <Compile Include="PooledBufferWriter.cs" />
    <Compile Include="ValueMatch.cs" />
    <Compile Include="ValueMatchEnumerator.cs" />
    <Compile Include="RegexFlags.cs" />
    <Compile Include="GeneratedRegexAttribute.cs" />
    <Compile Include="RegexMatchTimeoutException.cs" />
    <Compile Include="RegexParseException.cs" />
    <Compile Include="RegexPatternTooLargeException.cs" />
    <Compile Include="Syntax\EcmaRegexLimits.cs" />
    <Compile Include="Syntax\EcmaRegexNode.cs" />
    <Compile Include="Syntax\EcmaRegexParser.cs" />
    <Compile Include="Unicode\EcmaRegexUnicode.cs" />
    <Compile Include="Unicode\EcmaRegexUnicodeData.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Endjin.RecommendedPractices.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <!-- The source generator ships inside this package as an analyzer, so one reference gives the library and the generator. -->
  <ItemGroup>
    <ProjectReference Include="..\Corvus.Regex.Ecma262.SourceGenerator\Corvus.Regex.Ecma262.SourceGenerator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Corvus.Regex.Ecma262.SourceGenerator\bin\$(Configuration)\netstandard2.0\Corvus.Regex.Ecma262.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(NuGetPackageRoot)system.memory\4.6.3\lib\netstandard2.0\System.Memory.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Corvus.Regex.Ecma262.Tests" />
    <InternalsVisibleTo Include="probe" />
  </ItemGroup>
</Project>
