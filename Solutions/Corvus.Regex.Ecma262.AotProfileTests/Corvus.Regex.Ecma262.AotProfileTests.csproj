<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Matches patterns in a native AOT program compiled with a static profile, and checks every answer.

    A profile recorded on the JIT steers the AOT compiler's inlining and devirtualisation. profiles/Corvus.Text.Json-5.8.5.mibc
    is the part of the profile that Corvus.Text.Json 5.8.5 shipped which covers this library (dotnet-pgo merge
    include-reference Corvus.Regex.Ecma262 and System.Private.CoreLib). With it, the AOT compiler devirtualised the
    enumeration of an int[] through IEnumerable<int> in the automaton's closure wrongly, and patterns such as
    ^[0-9]+(ns|ms|us|µs|s|m|h)$ matched nothing. The aot workflow publishes this program and runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Corvus.Ecma262.RegularExpressions.AotProfileTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <MibcFile Include="profiles/Corvus.Text.Json-5.8.5.mibc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Corvus.Regex.Ecma262\Corvus.Regex.Ecma262.csproj" />
  </ItemGroup>
</Project>
