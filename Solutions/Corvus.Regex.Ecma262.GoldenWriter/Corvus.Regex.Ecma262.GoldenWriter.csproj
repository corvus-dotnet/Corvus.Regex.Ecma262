<Project>
  <!--
    Writes what a released version writes: built once for each version in ReleasedVersions.txt, with
    -p:GoldenVersion=<version>, against that version's Corvus.Regex.Ecma262.CodeGeneration.Sources package, whose
    emitter and image writer are compiled into this tool as source. Its output is the golden output the data set's
    golden check reads with the current library (docs/plan/image-compatibility.md). Each version restores and builds
    under obj/<version> and bin/<version>, so the versions never share a restore.
  -->
  <PropertyGroup>
    <GoldenVersion Condition="'$(GoldenVersion)' == ''">1.0.11</GoldenVersion>
    <BaseIntermediateOutputPath>obj\$(GoldenVersion)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Corvus.Ecma262.RegularExpressions.GoldenWriter</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputPath>bin\$(GoldenVersion)\</OutputPath>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);CS1591;CA1303;CA1305;CA1031;CA1812</NoWarn>
    <!-- Each version's obj folder sits beside this one's, so only the program is compiled. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Corvus.Regex.Ecma262.CodeGeneration.Sources" Version="$(GoldenVersion)" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
