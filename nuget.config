<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Don't use any higher level config files: the build is isolated from user and machine state. The website
       build adds a local source for the Vellum tool to a copy of this file (docs/website/build.ps1). -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
