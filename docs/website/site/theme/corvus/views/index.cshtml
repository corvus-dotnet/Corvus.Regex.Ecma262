@model SiteViewModel
@{
    Layout = "Shared/_Layout.cshtml";
    ViewBag.GitHubUrl = "https://github.com/corvus-dotnet/Corvus.Regex.Ecma262";
    ViewBag.MetaTitle = Model.PageContext.MetaData.Title;
    ViewBag.BodyClass = "page-home";
}
<!-- Hero -->
<section id="main-content" class="hero">
    <div class="hero__content">
        <h1 class="hero__title">ECMA-262 <span class="brand">regular expressions</span> for every platform</h1>
        <p class="hero__subtitle">
            The grammar and the answers of JavaScript's <code>RegExp</code> in fifteen languages, each held to V8's
            answers on the same test data: over UTF-8 and UTF-16, bounded in time and memory, with the grammar of
            ECMAScript 2020 and the Unicode of your choice a setting away.
        </p>
        <div class="hero__actions">
            <a href="#languages" class="btn btn--primary btn--lg">Choose your language</a>
            <a href="/docs/index.html" class="btn btn--secondary btn--lg">Documentation</a>
            <a href="@ViewBag.GitHubUrl"
               class="btn btn--secondary btn--lg" target="_blank" rel="noopener noreferrer">View on GitHub</a>
        </div>
    </div>
</section>

<!-- Languages -->
<section id="languages" class="home-languages">
    <div class="container">
        <div class="home-features__heading">
            <h2 class="home-features__title">Choose your language</h2>
            <p class="home-features__subtitle">One engine design, the same answers everywhere. Each page shows how to install it and write your first pattern.</p>
        </div>
        @await Html.PartialAsync("_Languages").ConfigureAwait(false)
    </div>
</section>

<!-- Stats -->
<div class="container">
    <div class="home-stats">
        <div class="home-stats__item">
            <div class="home-stats__value">15</div>
            <div class="home-stats__label">Languages, one design</div>
        </div>
        <div class="home-stats__item">
            <div class="home-stats__value">29.9M</div>
            <div class="home-stats__label">V8 answers matched, 0 wrong</div>
        </div>
        <div class="home-stats__item">
            <div class="home-stats__value">UTF-8</div>
            <div class="home-stats__label">and UTF-16, without transcoding</div>
        </div>
        <div class="home-stats__item">
            <div class="home-stats__value">2</div>
            <div class="home-stats__label"><a href="https://corvus-oss.org/corvus-regex-ecma262-benchmarks/">Architectures benchmarked nightly</a></div>
        </div>
    </div>
</div>

<!-- Features -->
<section class="home-features">
    <div class="container">
        <div class="home-features__heading">
            <h2 class="home-features__title">Built to answer as ECMAScript does</h2>
            <p class="home-features__subtitle">A pattern written for JavaScript, or taken from a JSON Schema, matches the same texts in every language.</p>
        </div>
        <div class="card-grid">
            <div class="card">
                <div class="card__icon">📜</div>
                <h3 class="card__title">The answers of ECMAScript</h3>
                <p class="card__body">ECMAScript 2025: lookbehind, named groups, modifier groups, Unicode property escapes, and the <code>u</code> and <code>v</code> flags. Every engine answers the whole ECMA-262 test data as V8 does, test262 included, with none wrong.</p>
            </div>
            <div class="card">
                <div class="card__icon">🔤</div>
                <h3 class="card__title">UTF-8 and UTF-16</h3>
                <p class="card__body">One matcher over either encoding, with no transcoding and positions in the units of the text. Text that is not UTF-8 is refused, never read as U+FFFD.</p>
            </div>
            <div class="card">
                <div class="card__icon">🗓️</div>
                <h3 class="card__title">ECMAScript 2020 and Unicode versions</h3>
                <p class="card__body">The grammar of ECMAScript 2020, which JSON Schema 2020-12 names, and the tables of Unicode 13, 17 or 18, each a setting chosen when a pattern is compiled, at no cost to a match.</p>
            </div>
            <div class="card">
                <div class="card__icon">⏱️</div>
                <h3 class="card__title">Bounded in time and memory</h3>
                <p class="card__body">A backtracking matcher that remembers where a way has failed, automata for the patterns that need no backtracking, a time limit on every match, and limits of size on every pattern. No pattern can overflow the stack.</p>
            </div>
            <div class="card">
                <div class="card__icon">⚡</div>
                <h3 class="card__title">Fast searches for a start</h3>
                <p class="card__body">Rare-byte literal searches, Teddy fingerprints and reverse automata find where a match can start, vectorised on x86-64 and arm64 where the language allows.</p>
            </div>
            <div class="card">
                <div class="card__icon">🔧</div>
                <h3 class="card__title">.NET: a drop-in with a generator</h3>
                <p class="card__body">The shape of <code>System.Text.RegularExpressions</code>, zero allocation per match, and <code>[GeneratedRegex]</code> writing the matcher as code at build time. <a href="/getting-started/dotnet.html">Read the .NET guide &rarr;</a></p>
            </div>
        </div>
    </div>
</section>

<!-- Code Example -->
<section class="home-code">
    <div class="container">
        <div class="home-code__inner">
            <div class="home-code__text">
                <h2 class="home-code__title">In .NET: from pattern to generated code</h2>
                <p class="home-code__description">
                    Put the attribute on a partial method, and the generator writes the matcher as code. The same
                    flags, the same answers, over both encodings.
                </p>
                <a href="/getting-started/dotnet.html" class="btn btn--primary">The .NET guide</a>
            </div>
            <div class="home-code__example">
                <pre><code class="language-csharp">using Corvus.Ecma262.RegularExpressions;

public static partial class Patterns
{
    [GeneratedRegex(@@"(?&lt;word&gt;\w+)@@(?&lt;host&gt;\w+)\.\w+", "gu")]
    public static partial Regex Email();
}

// Over a string
Match m = Patterns.Email().Match("mail sherlock@baker.st");
string host = m.Groups["host"].Value;                   // "baker"

// Over UTF-8, allocating nothing
ReadOnlySpan&lt;byte&gt; utf8 = "a@b.c and d@e.f"u8;
int n = Patterns.Email().Count(utf8);                   // 2</code></pre>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="home-cta">
    <div class="container">
        <div class="home-cta__inner">
            <h2 class="home-cta__title">Ready to get started?</h2>
            <p class="home-cta__description">Choose your language, install its package, and write a pattern with ECMA-262's flags.</p>
            <div class="home-cta__actions">
                <a href="/getting-started/index.html" class="btn btn--primary btn--lg">Get Started</a>
                <a href="/api/index.html" class="btn btn--secondary btn--lg">API Reference</a>
            </div>
        </div>
    </div>
</section>
